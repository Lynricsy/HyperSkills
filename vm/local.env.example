# 复制为 vm/local.env（已 gitignore）后填写；同名环境变量优先于本文件。
# 密钥只留在宿主：tools/vm.py 通过 msb --secret 注入占位符，VM 内读不到真实值。
# 评测默认模型 openai/gpt-6.1-sol 只需要 OpenAI 一组；用 anthropic/* 模型时再填另一组。

# OpenAI 兼容端点的 API key
OPENAI_API_KEY=
# 可选：OpenAI 兼容代理的根地址（含 /v1）；留空即官方 https://api.openai.com/v1
HS_VM_OPENAI_BASE_URL=

# Anthropic 兼容端点的 API key
ANTHROPIC_API_KEY=
# 可选：Anthropic 兼容代理的根地址（不含 /v1）；留空即官方 https://api.anthropic.com
HS_VM_ANTHROPIC_BASE_URL=

# 必填：VM 内 omp 的 smol 角色（每次挂载 skill 时压缩 skill 描述）固定用 workbuddy 的
# deepseek-v4.1-flash。缺这两项时 tools/vm.py 拒绝启动，否则 omp 会按内置表回落到已下线的模型。
WORKBUDDY_API_KEY=
# workbuddy 的 OpenAI 兼容根地址（含 /v1）
HS_VM_WORKBUDDY_BASE_URL=
