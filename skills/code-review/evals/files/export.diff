@@ -0,0 +1,22 @@
+const { pool } = require('../db/pool');
+
+const HEADER = 'id,sku,quantity,note,created_at';
+
+function toCsv(rows) {
+  const lines = rows.map((r) =>
+    [r.id, r.sku, r.quantity, r.note, r.created_at.toISOString()].join(','),
+  );
+  return [HEADER, ...lines].join('\n');
+}
+
+async function exportOrders(req, res) {
+  const { rows } = await pool.query(
+    'SELECT id, sku, quantity, note, created_at FROM orders WHERE customer_id = $1',
+    [req.query.customerId],
+  );
+  res.type('text/csv');
+  res.attachment(`orders-${req.query.customerId}.csv`);
+  res.send(toCsv(rows));
+}
+
+module.exports = { exportOrders, toCsv };
