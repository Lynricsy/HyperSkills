<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>Orders.Api</RootNamespace>
    <AssemblyName>Orders.Api</AssemblyName>
    <OutputPath>bin\api\</OutputPath>
    <DefineConstants>FEATURE_PROMOTIONS</DefineConstants>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.2" />
    <PackageReference Include="Serilog.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Endpoints/OrderEndpoints.cs" />
  </ItemGroup>

  <Import Project="..\eng\signing.props" />

</Project>
