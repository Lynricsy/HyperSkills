--- a/src/rates.ts
+++ b/src/rates.ts
@@ -12,9 +12,13 @@ const cache = new Map<string, { rate: number; storedAt: number }>();
 export function readRate(pair: string, now = Date.now()): number | undefined {
   const hit = cache.get(pair);
-  if (hit) {
-    return hit.rate;
